# ============================================
# ALUNAMDA Invoicing - Production Environment
# ============================================
# Copy this to .env and fill in the values

# Database
DATABASE_URL=sqlite+aiosqlite:///./db/alunamda.db

# Security - CHANGE THIS to a random string
# Generate one: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_64_CHARACTER_STRING

# JWT
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# Server
DEBUG=false
BASE_URL=https://yourdomain.com

# Items per page
ITEMS_PER_PAGE=25
ACTIVITY_PER_PAGE=50

# Uploads
MAX_UPLOAD_SIZE_MB=10
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.doc,.docx,.xls,.xlsx,.csv,.txt,.png,.jpg,.jpeg,.gif

# Company defaults
DEFAULT_COUNTRY=South Africa

# SMTP (optional - for email features)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true
